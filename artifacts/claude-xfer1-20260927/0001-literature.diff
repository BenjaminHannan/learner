+
+def full_budget_loss(net, items):
+    t, s, y = N.tensors(items)
+    ces, hls = [], []
+    for lg, q in net.loop_train(t, s, 0, FULL_ROUNDS)[-TAIL:]:
+        c_, ex = N.ce_and_exact(lg, s, y)
+        ces.append(c_)
+        hls.append(torch.nn.functional.binary_cross_entropy_with_logits(q.float(), ex))
+    return torch.stack(ces).mean() + 0.5 * torch.stack(hls).mean()
 
 
