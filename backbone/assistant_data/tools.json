  "function": {
   "name": "read_file",
   "description": "Read a text file from the local disk.",
   "parameters": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "description": "Absolute or ~-relative path"
     },
     "max_lines": {
      "type": "integer",
      "description": "Max lines to return",
      "minimum": 1,
      "maximum": 2000
     }
    },
