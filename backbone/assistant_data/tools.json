   "parameters": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "description": "File path"
     },
     "content": {
      "type": "string",
      "description": "Full file contents"
     },
     "append": {
      "type": "boolean",
      "description": "Append instead of overwrite"
     }
    },
    "required": [
     "path",
     "content"
    ],
    "additionalProperties": false
   }
  }
 },
