+def top_up(records, m_min, seed, arm='Z', tries=40):
+    """Fresh prompts for every distinct found program that has fewer than m_min records, up to m_min (rules seen rarely get more example sets)."""
+    rng = random.Random(f'topup|{seed}')
+    count, first = {}, {}
+    for r in records:
+        tf = P.train_form(fewshot.record_try(r))
+        if tf is None:
+            continue
+        key = (tuple(tf[0]), tf[1])
+        count[key] = count.get(key, 0) + 1
+        first.setdefault(key, (tf, r['id']))
+    out = []
+    for key, n in count.items():
+        tf, src = first[key]
+        t = P.Try.make(*tf)
+        need, made = m_min - n, 0
+        for _ in range(tries * max(need, 0)):
+            if made >= need:
+                break
+            xs = rng.sample(DOMAIN, 4)
+            ys = [_value(t, x) for x in xs]
+            if None in ys or min(ys) < 0 or len(set(ys)) == 1 or any(y in CONST_VALUES for y in ys[:3]) or max(ys) >= 10 ** 6:
+                continue
+            row = {'id': f'{src}:t{made}', 'prompt': prompt_of(xs[:3], ys[:3], xs[3])}
+            if not fewshot.structure(fewshot.parse(row['prompt']), t)[0]:
+                continue
+            out.append(fewshot._record(row, t, arm, len(out)))
+            made += 1
+    return out
