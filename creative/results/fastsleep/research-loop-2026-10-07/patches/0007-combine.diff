+
+
+def top_up(records, m_min, seed, inputs, lo, hi, arm='Z', tries=40):
+    """Fresh prompts for every distinct found program with fewer than m_min records, up to m_min (rarely found rules get more example sets)."""
+    rng = random.Random(f'topup|{seed}')
+    count, first = {}, {}
+    for r in records:
+        tf = P.train_form(fewshot.record_try(r))
+        if tf is None:
+            continue
+        key = (tuple(tf[0]), tf[1])
+        count[key] = count.get(key, 0) + 1
+        first.setdefault(key, r)
+    out = []
+    for key, n in count.items():
+        r = first[key]
+        out += replay_per_record([r], m_min - n, f'{seed}|{len(out)}', inputs, lo, hi, arm=arm, tries=tries) if n < m_min else []
+    return out
