+"""Second night (expert iteration round 2): the slept model tries every pool question again; tries that fit all 3 examples become new records."""
+import random
+from creative import fewshot, legal
+
+
+def night_records(m, ctx, n=32, temperature=1.0, per_cap=2, arm='W2'):
+    m.eval()
+    rows = [dict(r, answer='0') for r in ctx.pool]          # make_batch wants an answer field; sampling never reads it (not the key)
+    smp = legal.raw_samples(m, rows, ctx.vocab, ctx.device, n=n, temperature=temperature, level=0, seed=ctx.seed + 17)
+    rng = random.Random(f'night2|{ctx.seed}')
+    out = []
+    for row, tr in zip(ctx.pool, smp):
+        p = fewshot.parse(row['prompt'])
+        for k, t in enumerate(fewshot._distinct(p, tr, rng, per_cap, lambda rules, full: full[0] == 'accept')):
+            out.append(fewshot._record(dict(row), t, arm, k))
+    m.train()
+    return out
