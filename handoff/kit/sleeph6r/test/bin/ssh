#!/bin/bash
# FAKE ssh for the kit tests only: the "rental" is this box (its /root/r is a real folder made by the test runner), so the remote
# command runs locally, stdin and stdout passed through. Fault injection through files under $FAKE/ssh:
#   dead            host does not answer (exit 255)
#   hang-on         a substring; while count-file hang-count > 0 a command containing it never returns (killed by the caller's bound)
#   mutate-on-tar   N: the first N `tar -cf -` calls first append a byte to W/s13.log (a file that grew after the manifest was made)
S=$FAKE/ssh; mkdir -p "$S"
while [ $# -gt 1 ]; do
  case "$1" in -i|-o|-p) shift 2;; -*) shift;; root@*) shift; break;; *) break;; esac
done
cmd=$*
echo "$(date -u +%T) $cmd" | cut -c1-240 >> "$S/calls.log"
[ -e "$S/dead" ] && exit 255
case "$cmd" in *"tar -x -C /root/r"*) { [ -s "$GH6V/state" ] && echo "state-before-upload yes" || echo "state-before-upload NO"; [ -s "$GH6V/guard.pid" ] && echo "guard-before-upload yes" || echo "guard-before-upload NO"; } >> "$S/upload-precheck.txt";; esac
if [ -s "$S/hang-on" ] && [ "$(cat "$S/hang-count" 2>/dev/null || echo 0)" -gt 0 ]; then
  case "$cmd" in *"$(cat "$S/hang-on")"*) echo $(( $(cat "$S/hang-count") - 1 )) > "$S/hang-count"; echo "hang: $cmd" | cut -c1-120 >> "$S/hung.log"; echo $$ >> "$S/hung.pids"; exec /usr/bin/sleep 100000;; esac; fi
case "$cmd" in *"tar -cf -"*) m=$(cat "$S/mutate-on-tar" 2>/dev/null || echo 0)
  if [ "$m" -gt 0 ]; then echo $((m-1)) > "$S/mutate-on-tar"; [ -f /root/r/W/s13.log ] && printf 'x' >> /root/r/W/s13.log; fi;; esac
exec /bin/bash -c "$cmd"
